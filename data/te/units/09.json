        { "native": "ఆమె జుట్టు చాలా పొడవు.", "roman": "āme juṭṭu chālā poḍavu.", "en": "Her hair is very long." },
        { "native": "అతని ముఖం ఎర్రగా ఉంది.", "roman": "atani mukham erragā undi.", "en": "His face is red.", "focus": "అతని", "wrong": ["అతను|atanu", "అతనికి|ataniki"] },
        { "native": "పాప నోట్లో ఏమి ఉంది?", "roman": "pāpa nōṭlō ēmi undi?", "en": "What's in the baby's mouth?", "focus": "నోట్లో", "wrong": ["నోరు|nōru", "నోరులో|nōrulō"] },
        { "native": "బాబు పళ్ళు తెల్లగా ఉన్నాయి.", "roman": "bābu paḷḷu tellagā unnāyi.", "en": "The little boy's teeth are white.", "focus": "పళ్ళు", "wrong": ["పన్ను|pannu", "పన్నులు|pannulu"] },
        { "native": "తాతయ్య జుట్టు తెల్లగా ఉంది.", "roman": "tātayya juṭṭu tellagā undi.", "en": "Grandpa's hair is white.", "focus": "ఉంది", "wrong": ["ఉన్నాయి|unnāyi", "ఉన్నాడు|unnāḍu"] },
        { "native": "నా చెవిలో నీళ్ళు ఉన్నాయి.", "roman": "nā chevilō nīḷḷu unnāyi.", "en": "There's water in my ear.", "focus": "చెవిలో", "wrong": ["చెవి|chevi", "చెవికి|cheviki"] },
        { "native": "మీ గొంతు చాలా బాగుంది.", "roman": "mī gontu chālā bāgundi.", "en": "You have a lovely voice." },
        { "native": "నా ముక్కు ఎర్రగా ఉంది.", "roman": "nā mukku erragā undi.", "en": "My nose is red." },
        { "native": "నా తల వేడిగా ఉంది.", "roman": "nā tala vēḍigā undi.", "en": "My head feels hot." }
      ]
    },
    {
      "title": "Where does it hurt?",
      "tip": { "title": "Aches: నొప్పిగా ఉంది", "body": "- Body part + **నొప్పిగా ఉంది**: నా కాలు నొప్పిగా ఉంది 'my leg hurts'. Plural parts take ఉన్నాయి: కాళ్ళు నొప్పిగా ఉన్నాయి.\n- Aches happen *to* you, so the person takes -కు: **నాకు** తలనొప్పిగా ఉంది.\n- An illness 'comes': నాకు జ్వరం **వచ్చింది**; a cold 'does': జలుబు **చేసింది**.", "pattern": "నాకు + body part + నొప్పిగా ఉంది", "grammar": 0 },
      "new": ["మెడ", "చెయ్యి", "వేలు", "కాలు", "కడుపు", "వీపు", "గుండె", "నొప్పి", "ఎక్కడ నొప్పిగా ఉంది?", "ఇక్కడ నొప్పిగా ఉంది."],
      "sentences": [
        { "native": "నా వీపు నొప్పిగా ఉంది.", "roman": "nā vīpu noppigā undi.", "en": "My back hurts.", "focus": "నొప్పిగా", "wrong": ["నొప్పితో|noppitō", "నొప్పికి|noppiki"] },
        { "native": "నాకు కడుపు నొప్పిగా ఉంది.", "roman": "nāku kaḍupu noppigā undi.", "en": "I have a stomach ache.", "focus": "నొప్పిగా", "wrong": ["నొప్పితో|noppitō", "నొప్పికి|noppiki"] },
