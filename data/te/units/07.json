      { "speaker": "Divya", "native": "సరే, మూడున్నరకి. ఆలస్యం చేయకు!", "roman": "sarē, mūḍunnaraki. ālasyam chēyaku!", "en": "Fine, half three. Don't be late!" },
      { "speaker": "Anil", "native": "లేదు లేదు, టైంకి వస్తాను.", "roman": "lēdu lēdu, ṭaimki vastānu.", "en": "No, no, I'll be on time." }
    ]
