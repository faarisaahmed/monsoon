  "phrases": [
    { "native": "మీ ఇల్లు ఎక్కడ?", "roman": "mī illu ekkaḍa?", "en": "Where is your house?" },
    { "native": "ఇది మా ఇల్లు, లోపలికి రండి.", "roman": "idi mā illu, lōpaliki raṇḍi.", "en": "This is our home, come in." },
    { "native": "చెప్పులు బయట వదలండి.", "roman": "cheppulu bayaṭa vadalaṇḍi.", "en": "Please leave your footwear outside." },
    { "native": "బాత్రూం ఎక్కడ ఉంది?", "roman": "bātrūm ekkaḍa undi?", "en": "Where is the bathroom?" },
