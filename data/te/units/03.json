  "phrases": [
    { "native": "మీ కుటుంబంలో ఎంతమంది ఉన్నారు?", "roman": "mī kuṭumbamlō entamandi unnāru?", "en": "How many people are in your family?" },
    { "native": "మా కుటుంబంలో ఐదుగురు ఉన్నారు.", "roman": "mā kuṭumbamlō aiduguru unnāru.", "en": "There are five of us in my family." },
    { "native": "మీకు పెళ్ళైందా?", "roman": "mīku peḷḷaindā?", "en": "Are you married?" },
    { "native": "నాకు పెళ్ళైంది.", "roman": "nāku peḷḷaindi.", "en": "I'm married." },
    { "native": "ఇంకా పెళ్ళి కాలేదు.", "roman": "iṅkā peḷḷi kālēdu.", "en": "Not married yet." },
    { "native": "మీకు పిల్లలు ఉన్నారా?", "roman": "mīku pillalu unnārā?", "en": "Do you have children?" },
    { "native": "నాకు ఒక కొడుకు, ఒక కూతురు.", "roman": "nāku oka koḍuku, oka kūturu.", "en": "I have a son and a daughter." },
    { "native": "ఈమె మా అక్క.", "roman": "īme mā akka.", "en": "This is my elder sister." },
