      { "speaker": "Meena", "native": "మీకు పెళ్ళైందా?", "roman": "mīku peḷḷaindā?", "en": "Are you married?" },
      { "speaker": "Priya", "native": "అవును. మా ఆయన పేరు శ్రీనివాస్.", "roman": "avunu. mā āyana pēru shrīnivās.", "en": "Yes. My husband's name is Srinivas." },
      { "speaker": "Meena", "native": "పిల్లలు?", "roman": "pillalu?", "en": "Children?" },
