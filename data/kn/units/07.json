        { "native": "ಹತ್ತು ನಿಮಿಷ ಕಾಯಿರಿ, ಬರ್ತೀನಿ.", "roman": "hattu nimiṣa kāyiri, bartīni.", "en": "Wait ten minutes, I'm coming.", "focus": "ನಿಮಿಷ", "wrong": ["ಗಂಟೆಗೆ|gaṇṭege", "ನಿಮಿಷಕ್ಕೆ|nimiṣakke"] },
