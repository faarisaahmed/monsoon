  "phrases": [
    { "native": "ಈಗ ಎಷ್ಟು ಗಂಟೆ?", "roman": "īga eṣṭu gaṇṭe?", "en": "What time is it now?", "note": "Very common: ಟೈಮ್ ಎಷ್ಟು? ṭaim eṣṭu?" },
    { "native": "ಈಗ ಮೂರೂವರೆ ಗಂಟೆ", "roman": "īga mūrūvare gaṇṭe", "en": "It's half past three now." },
