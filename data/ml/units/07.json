        { "native": "സമയം എട്ടേകാൽ ആയി.", "roman": "samayam eṭṭēkāl āyi.", "en": "It's quarter past eight.", "focus": "എട്ടേകാൽ", "wrong": ["എട്ടര|eṭṭara", "എട്ടേമുക്കാൽ|eṭṭēmukkāl"] },
