        { "native": "അവന്റെ ഫോൺ കറുപ്പാണ്.", "roman": "avande fōṇ kaṟuppāṇŭ.", "en": "His phone is black.", "focus": "കറുപ്പാണ്", "wrong": ["കറുത്ത|kaṟutta", "കറുപ്പ്|kaṟuppŭ"] },
