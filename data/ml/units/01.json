    { "native": "ഹലോ", "roman": "halō", "en": "hello (casual; on the phone)", "pos": "interj" },
    { "native": "അതെ", "roman": "ate", "en": "yes (that's right)", "pos": "interj", "note": "Also spelled അതേ. Colloquially often just ആ (ā) or ഉം (um)." },
    { "native": "അല്ല", "roman": "alla", "en": "no; it is not (identity)", "pos": "interj", "note": "Negates 'X is Y': ഇത് ചായ അല്ല 'this is not tea'." },
    { "native": "ഇല്ല", "roman": "illa", "en": "no; there isn't; not (existence/verbs)", "pos": "interj", "note": "Negates existence and verbs: ചായ ഇല്ല 'there's no tea'." },
    { "native": "ഉണ്ട്", "roman": "uṇḍŭ", "en": "there is; (I) have; yes (there is)", "pos": "verb", "note": "The positive partner of ഇല്ല." },
    { "native": "ശരി", "roman": "shari", "en": "OK; right; correct", "pos": "interj" },
    { "native": "നന്ദി", "roman": "nandi", "en": "thanks", "pos": "noun", "note": "Used less than English 'thanks' among family/friends; with service staff a smile is enough." },
