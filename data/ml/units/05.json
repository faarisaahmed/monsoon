  "phrases": [
    { "native": "എനിക്ക് ഒരു ചായ വേണം.", "roman": "enikkŭ oru chāya vēṇam.", "en": "I'd like a tea." },
    { "native": "ചേട്ടാ, രണ്ട് ചായ!", "roman": "chēṭṭā, raṇḍŭ chāya!", "en": "Two teas, please! (calling to the man at the stall)" },
    { "native": "പഞ്ചസാര വേണ്ട.", "roman": "pañjasāra vēṇḍa.", "en": "No sugar, please." },
    { "native": "ഭക്ഷണം കഴിച്ചോ?", "roman": "bhakṣaṇam kaḻicchō?", "en": "Have you eaten? (friendly greeting)" },
    { "native": "എനിക്ക് വിശക്കുന്നു.", "roman": "enikkŭ vishakkunnu.", "en": "I'm hungry." },
    { "native": "എനിക്ക് ദാഹിക്കുന്നു.", "roman": "enikkŭ dāhikkunnu.", "en": "I'm thirsty." },
    { "native": "എരിവ് കുറച്ച് മതി.", "roman": "erivŭ kuṟacchŭ mati.", "en": "Only a little spice, please." },
    { "native": "എനിക്ക് മീൻ കറി വളരെ ഇഷ്ടമാണ്.", "roman": "enikkŭ mīn kaṟi vaḷare iṣṭamāṇŭ.", "en": "I really like fish curry." },
    { "native": "ഞാൻ ഇറച്ചി കഴിക്കില്ല.", "roman": "ñān iṟacchi kaḻikkilla.", "en": "I don't eat meat." },
    { "native": "കുറച്ച് വെള്ളം തരാമോ?", "roman": "kuṟacchŭ veḷḷam tarāmō?", "en": "Could you give me some water?" },
