        { "native": "അവർ ഡോക്ടർ ആണ്.", "roman": "avar ḍōkṭar āṇŭ.", "en": "She's a doctor. (respectful)", "focus": "ആണ്", "wrong": ["ഉണ്ട്|uṇḍŭ", "ആണോ|āṇō"] },
