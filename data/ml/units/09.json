        { "native": "കഴുത്തിന് വേദനയുണ്ട്.", "roman": "kaḻuttinŭ vēdanayuṇḍŭ.", "en": "My neck hurts.", "focus": "കഴുത്തിന്", "wrong": ["കഴുത്ത്|kaḻuttŭ", "കഴുത്തിന്റെ|kaḻuttinde"] },
        { "native": "എന്ത് പറ്റി? കണ്ണ് വേദനിക്കുന്നുണ്ടോ?", "roman": "endŭ paṯṯi? kaṇṇŭ vēdanikkunnuṇḍō?", "en": "What's wrong? Does your eye hurt?", "focus": "വേദനിക്കുന്നുണ്ടോ", "wrong": ["വേദനിക്കുന്നു|vēdanikkunnu", "വേദന|vēdana"] },
        { "native": "പല്ലിന് നല്ല വേദനയുണ്ട്.", "roman": "pallinŭ nalla vēdanayuṇḍŭ.", "en": "My tooth really hurts.", "focus": "പല്ലിന്", "wrong": ["പല്ല്|pallŭ", "പല്ലിന്റെ|pallinde"] },
        { "native": "വയറ് വേദനിക്കുന്നു, ഭക്ഷണം വേണ്ട.", "roman": "vayaṟŭ vēdanikkunnu, bhakṣaṇam vēṇḍa.", "en": "My stomach hurts, I don't want any food.", "focus": "വേദനിക്കുന്നു", "wrong": ["വേദന|vēdana", "വേദനയുണ്ട്|vēdanayuṇḍŭ"] },
        { "native": "കണ്ണിന് എന്ത് പറ്റി?", "roman": "kaṇṇinŭ endŭ paṯṯi?", "en": "What happened to your eye?", "focus": "കണ്ണിന്", "wrong": ["കണ്ണ്|kaṇṇŭ", "കണ്ണിന്റെ|kaṇṇinde"] },
        { "native": "ശരീരം വേദനിക്കുന്നു.", "roman": "sharīram vēdanikkunnu.", "en": "My body aches." }
      ]
