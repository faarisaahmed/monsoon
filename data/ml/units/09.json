  "phrases": [
    { "native": "എന്ത് പറ്റി?", "roman": "endŭ paṯṯi?", "en": "What happened? What's wrong?" },
    { "native": "എനിക്ക് സുഖമില്ല.", "roman": "enikkŭ sukhamilla.", "en": "I'm not well." },
    { "native": "എനിക്ക് പനിയുണ്ട്.", "roman": "enikkŭ paniyuṇḍŭ.", "en": "I have a fever." },
    { "native": "എനിക്ക് നല്ല തലവേദനയാണ്.", "roman": "enikkŭ nalla talavēdanayāṇŭ.", "en": "I have a bad headache." },
    { "native": "എന്റെ വയറ് വേദനിക്കുന്നു.", "roman": "ende vayaṟŭ vēdanikkunnu.", "en": "My stomach hurts." },
