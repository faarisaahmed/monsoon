  "phrases": [
    { "native": "மணி என்ன?", "roman": "maṇi enna?", "en": "What time is it?" },
    { "native": "மணி மூணு.", "roman": "maṇi mūṇu.", "en": "It's three o'clock." },
    { "native": "மணி நாலரை.", "roman": "maṇi nālarai.", "en": "It's half past four." },
    { "native": "இப்போ ஏழே கால்.", "roman": "ippō ēḻē kāl.", "en": "It's quarter past seven now." },
    { "native": "எத்தன மணிக்கு?", "roman": "ettana maṇikku?", "en": "At what time?" },
    { "native": "காலையில பத்து மணிக்கு.", "roman": "kālaiyila pattu maṇikku.", "en": "At ten in the morning." },
    { "native": "இன்னைக்கு என்ன கிழமை?", "roman": "innaikku enna kiḻamai?", "en": "What day is it today?" },
    { "native": "இன்னைக்கு வெள்ளிக்கிழமை.", "roman": "innaikku veḷḷikkiḻamai.", "en": "Today is Friday." },
    { "native": "நாளைக்குப் பாக்கலாம்.", "roman": "nāḷaikkup pākkalām.", "en": "See you tomorrow." },
