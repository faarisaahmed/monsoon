  "phrases": [
    { "native": "எனக்குப் பசிக்குது.", "roman": "enakkup pasikkudu.", "en": "I'm hungry." },
    { "native": "எனக்கு ஒரு காபி வேணும்.", "roman": "enakku oru kāpi vēṇum.", "en": "I want a coffee." },
    { "native": "ரெண்டு இட்லி, ஒரு தோசை குடுங்க.", "roman": "reṇḍu iḍli, oru dōsai kuḍunga.", "en": "Two idlis and one dosa, please." },
