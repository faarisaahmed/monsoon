        { "native": "அவருக்குப் பல் வலிக்குது.", "roman": "avarukkup pal valikkudu.", "en": "He has toothache.", "focus": "அவருக்குப்", "wrong": ["அவரு|avaru", "அவர்|avar"] },
        { "native": "எனக்குக் காது வலிக்குது.", "roman": "enakkuk kādu valikkudu.", "en": "My ear hurts.", "focus": "வலிக்குது", "wrong": ["வலிக்குதா|valikkudā", "பசிக்குது|pasikkudu"] },
        { "native": "உங்களுக்குப் பல் வலிக்குதா?", "roman": "ungaḷukkup pal valikkudā?", "en": "Do you have toothache?", "focus": "வலிக்குதா", "wrong": ["வலிக்குது|valikkudu", "வலி|vali"] },
        { "native": "குழந்தைக்குக் காது வலி.", "roman": "kuḻandaikkuk kādu vali.", "en": "The baby has earache.", "focus": "குழந்தைக்குக்", "wrong": ["குழந்தை|kuḻandai", "குழந்தைங்க|kuḻandainga"] },
        { "native": "ஐயோ, ரொம்ப வலிக்குது!", "roman": "aiyō, romba valikkudu!", "en": "Ouch, it really hurts!", "focus": "வலிக்குது", "wrong": ["வலி|vali", "வலிக்குதா|valikkudā"] },
        { "native": "அம்மாவுக்குத் தலைவலி.", "roman": "ammāvukkut talaivali.", "en": "Mum has a headache.", "focus": "அம்மாவுக்குத்", "wrong": ["அம்மா|ammā", "அம்மாவை|ammāvai"] },
        { "native": "இப்போ தலைவலி இல்ல.", "roman": "ippō talaivali illa.", "en": "I don't have a headache any more." }
      ]
    },
    {
      "title": "Hands, legs, back and stomach",
      "tip": { "title": "Body words in speech", "body": "- Many get an extra **-உ** in speech: கண் → **கண்ணு**, பல் → **பல்லு**.\n- வயிறு becomes **வயித்து-** before another word or ending: **வயித்து வலி** 'stomach ache'.\n- **கை** is hand and arm; **கால்** is leg and foot.\n- 'Both legs' = ரெண்டு **காலும்**." },
      "new": ["கை", "கால்", "வயிறு", "முதுகு", "நெஞ்சு", "மூக்கு", "வாய்", "தலைமுடி", "எனக்கு வயித்து வலி."],
      "sentences": [
        { "native": "எனக்கு முதுகு வலிக்குது.", "roman": "enakku mudugu valikkudu.", "en": "My back hurts.", "focus": "முதுகு", "wrong": ["வயிறு|vayiru", "நெஞ்சு|nenju"] },
        { "native": "குழந்தைக்கு வயித்து வலி.", "roman": "kuḻandaikku vayittu vali.", "en": "The child has a stomach ache.", "focus": "வயித்து", "wrong": ["வயிறு|vayiru", "வயித்துல|vayittula"] },
        { "native": "ரெண்டு காலும் வலிக்குது.", "roman": "reṇḍu kālum valikkudu.", "en": "Both my legs hurt.", "focus": "காலும்", "wrong": ["கையும்|kaiyum", "கண்ணும்|kaṇṇum"] },
        { "native": "அவருக்குக் கை வலிக்குது.", "roman": "avarukkuk kai valikkudu.", "en": "His arm hurts.", "focus": "கை", "wrong": ["கால்|kāl", "காது|kādu"] },
        { "native": "நெஞ்சு வலிக்குதா?", "roman": "nenju valikkudā?", "en": "Do you have chest pain?", "focus": "நெஞ்சு", "wrong": ["முதுகு|mudugu", "வயிறு|vayiru"] },
        { "native": "அவனுக்கு மூக்கு ரொம்ப நீளம்.", "roman": "avanukku mūkku romba nīḷam.", "en": "He has a very long nose.", "focus": "மூக்கு", "wrong": ["வாய்|vāy", "காது|kādu"] },
        { "native": "அவளுக்கு நீளமான தலைமுடி.", "roman": "avaḷukku nīḷamāna talaimuḍi.", "en": "She has long hair." },
        { "native": "குழந்தை வாயில என்ன இருக்கு?", "roman": "kuḻandai vāyila enna irukku?", "en": "What's in the baby's mouth?", "focus": "வாயில", "wrong": ["வாய்|vāy", "வாய்க்கு|vāykku"] }
      ]
    },
    {
      "title": "Fever, cold and cough",
      "tip": { "title": "Saying you are ill", "body": "- 'I'm not well' = **உடம்பு சரியில்ல** (lit. 'the body isn't right').\n- Illnesses use the dative too: **எனக்குக் காய்ச்சல்** 'I have a fever', அவனுக்கு **இருமல்**. Add **இருக்கு** if you like.\n- 'For three days' = மூணு **நாளா**.", "pattern": "X-க்கு + illness (+ இருக்கு)", "grammar": 0 },
