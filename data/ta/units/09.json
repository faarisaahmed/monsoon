  "phrases": [
    { "native": "எனக்கு உடம்பு சரியில்ல.", "roman": "enakku uḍambu sariyilla.", "en": "I'm not feeling well." },
    { "native": "எனக்குத் தலை வலிக்குது.", "roman": "enakkut talai valikkudu.", "en": "I have a headache." },
    { "native": "எனக்கு வயித்து வலி.", "roman": "enakku vayittu vali.", "en": "I have a stomach ache." },
    { "native": "எனக்குக் காய்ச்சல் இருக்கு.", "roman": "enakkuk kāycchal irukku.", "en": "I have a fever." },
    { "native": "எங்க வலிக்குது?", "roman": "enga valikkudu?", "en": "Where does it hurt?" },
    { "native": "இங்க வலிக்குது.", "roman": "inga valikkudu.", "en": "It hurts here." },
    { "native": "டாக்டரைப் பாக்கணும்.", "roman": "ḍākṭaraip pākkaṇum.", "en": "I need to see a doctor." },
    { "native": "பக்கத்துல மெடிக்கல் ஷாப் இருக்கா?", "roman": "pakkattula meḍikal shāp irukkā?", "en": "Is there a pharmacy nearby?" },
    { "native": "இந்த மாத்திரையை ஒரு நாளைக்கு ரெண்டு தடவை சாப்பிடுங்க.", "roman": "inda māttiraiyai oru nāḷaikku reṇḍu taḍavai sāppiḍunga.", "en": "Take this tablet twice a day." },
    { "native": "நல்லா ஓய்வு எடுங்க.", "roman": "nallā ōyvu eḍunga.", "en": "Get plenty of rest." },
