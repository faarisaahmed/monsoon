    { "native": "நான் மூணாவது மாடியில இருக்கேன்.", "roman": "nān mūṇāvadu māḍiyila irukkēn.", "en": "I live on the third floor." },
    { "native": "ஒண்ணு மட்டும் போதும்.", "roman": "oṇṇu maṭṭum pōdum.", "en": "Just one is enough." },
    { "native": "ரொம்ப ஜாஸ்தி!", "roman": "romba jāsti!", "en": "That's too much!" }
