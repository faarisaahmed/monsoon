  "phrases": [
    { "native": "உங்களுக்கு என்ன வயசு?", "roman": "ungaḷukku enna vayasu?", "en": "How old are you? (lit. to you what age?)" },
    { "native": "எனக்கு முப்பது வயசு.", "roman": "enakku muppadu vayasu.", "en": "I'm thirty years old." },
